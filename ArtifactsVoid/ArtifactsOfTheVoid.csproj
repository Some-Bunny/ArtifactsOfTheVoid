		<PackageReference Include="MMHOOK.RoR2" Version="*" NoWarn="NU1701" />
        <PackageReference Include="RoR2BepInExPack" Version="*" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="R2API.Prefab">
	    <HintPath>..\..\..\r2modmanLocal\RiskOfRain2\profiles\test\BepInEx\plugins\RiskofThunder-R2API_Prefab\R2API.Prefab\R2API.Prefab.dll</HintPath>
	  </Reference>
