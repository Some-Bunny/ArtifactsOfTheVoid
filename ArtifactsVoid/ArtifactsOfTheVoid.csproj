<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json
		</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Textures\infestorDisabled.png" />
	  <None Remove="Textures\infestorEnabled.png" />
	  <None Remove="Textures\invasionDisabled.png" />
	  <None Remove="Textures\invasionEnabled.png" />
	  <None Remove="Textures\nullifyDisabled.png" />
